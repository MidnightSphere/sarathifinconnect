{
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/api/chat/?$", "dest": "/api/chat" },
    { "src": "^/invitation(/.*)?$", "dest": "/invitation/index.html", "status": 200 },
    { "src": "^/$", "dest": "/index.html", "status": 200 },
    {
      "src": "^/(services|loans)(/(home-loan|car-loan|business-loan|personal-loan|loan-against-property|loan-against-securities|gold-loan|machinery-loan|commercial-vehicle-loan|home-loan-balance-transfer|education-loan|sme-msme-loan|business-equipment-finance|working-capital-finance|solar-project-finance))?/?$",
      "dest": "/index.html",
      "status": 200
    },
    { "src": "^/about/?$", "dest": "/index.html", "status": 200 },
    { "src": "^/(?!api(?:/|$)).*$", "dest": "/index.html", "status": 404 }
  ]
}
